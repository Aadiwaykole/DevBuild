generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  githubId  String   @unique
  username  String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

repositories Repository[]
skills       Skill[]
insights     AIInsight[]
syncJobs     SyncJob[]
}

model Repository {
  id              String   @id @default(uuid())
  githubId        Int      @unique
  name            String
  description     String?
  language        String?
  stars           Int      @default(0)
  forks           Int      @default(0)

  defaultBranch   String?
  openIssues      Int      @default(0)
  size            Int      @default(0)
  htmlUrl         String?

  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId          String
  user            User @relation(fields: [userId], references: [id])

  commits         Commit[]
  languages       RepositoryLanguage[]
  dependencies    Dependency[]
}

model Commit {
  id           String     @id @default(uuid())
  githubId     String     @unique
  message      String
  committedAt  DateTime

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id])
}

model RepositoryLanguage {
  id           String     @id @default(uuid())
  language     String
  bytes        Int

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id])
}

model Dependency {
  id           String   @id @default(uuid())
  name         String
  version      String
  type         String

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id])
}

model Skill {
  id        String     @id @default(uuid())
  name      String
  category  String
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])
}

model AIInsight {
  id               String   @id @default(uuid())
  developmentFocus String
  strongestSkill   String
  nextLearningArea String
  summary          String
  recommendations  Json
  createdAt        DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])
}

model SyncJob {
  id          String    @id @default(uuid())
  status      String
  startedAt   DateTime?
  completedAt DateTime?
  error       String?

  userId      String
  user        User      @relation(fields: [userId], references: [id])

  createdAt   DateTime  @default(now())
}